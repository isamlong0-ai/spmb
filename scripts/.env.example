# Salin file ini menjadi .env di folder scripts/, lalu isi nilai aslinya.
# JANGAN commit file .env ke GitHub.

# Supabase (Project Settings -> API). Service role key boleh dipakai di server lokal,
# tetapi JANGAN pernah ditaruh di frontend/browser.
SUPABASE_URL=https://eyugtyqppolmynhxccot.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tempel_service_role_key_di_sini

# Tahun pelajaran yang ditarik (boleh ditimpa dengan --tahun=2027/2028)
TAHUN_PELAJARAN=2026/2027

# Database MySQL/MariaDB lokal sekolah
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spmb
DB_PASSWORD=password_lokal
DB_NAME=spmb_sekolah
